# 接続テストの操作パネル (tools/control_panel、launchd: com.championsadviser.control-panel) の設定。
# ポートは config/ports.env の CONTROL_PORT_DEFAULT。
#
# 待ち受けアドレス。フロントエンドと同じく LAN の別端末 (スマホ等) からも開けるように 0.0.0.0。
# このMacからだけにするなら 127.0.0.1 (パネルは固定のスクリプトしか実行しないが、認証は無い)
CONTROL_BIND=0.0.0.0
# ページの状態更新間隔 (秒)
CONTROL_POLL_SEC=3
# 出力欄に表示する末尾の行数
CONTROL_LOG_TAIL_LINES=150
# ジョブに渡す PATH の先頭 (node / lsof 等。launchd の PATH は最小なので補う)
CONTROL_PATH_PREFIX=/opt/homebrew/bin:/usr/local/bin
# フレーム統計 (受信/処理/破棄) を探す server ログ末尾のサイズ (バイト)
CONTROL_SERVER_LOG_TAIL_BYTES=65536
