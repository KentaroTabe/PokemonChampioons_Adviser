# 常駐のポート既定値 (scripts/lib/ports.sh が読む)。
# 既定ポートを別のプロセスが使っていれば、起動スクリプトが +1 ずつ PORT_SEARCH_RANGE まで空きを探して使う。
# 実際に使ったポートは logs/ports.env (シェル用) と config/ports.local.js (フロントが読む) に書かれる。
ADVISOR_PORT_DEFAULT=8000
FRONTEND_PORT_DEFAULT=3000
PORT_SEARCH_RANGE=20
# ローカル Showdown (学習・測定・分析パネルが使う。起動スクリプトは固定でこのポート)
SHOWDOWN_PORT_DEFAULT=8100
# 接続テストの操作パネル (tools/control_panel、launchd 常駐。ずらさない)
CONTROL_PORT_DEFAULT=8010
# 起動の確認 (2026-10-23): start_connection_test.sh は今回起動したアドバイザーのプロセス (pid、logs/.advisor_launch_pid) について、
# ポートの待受と DEBUG_DUMP_FRAMES=1 の両方を確認できるまで最大この秒数待つ (1 秒ごと)。時間切れは「確認できず」
ADVISOR_LAUNCH_CHECK_SEC=30
