# 実機 (アドバイザーの常駐) の採点方式の設定 (方式 C、2026-10-16。docs/CONNECTION_TEST_CHECKLIST.md の「採点方式を変えて試験する」)。
# config/advice.local.env (追跡しない) にコピーして使う:  cp config/advice.local.env.example config/advice.local.env
#
# - 読むのは起動スクリプトだけ (scripts/advice_env.sh を通す start_connection_test.sh / start_all_nohup.sh /
#   start_servers.sh / deploy.sh。操作パネルの「接続テスト開始」「更新の反映」と launchd の daily-deploy もこれを通る)。
#   champions_agent/config.py と測定の子プロセス (usefulness_p1 / arc_remeasure / 学習) は読まない
# - 書けるのは ADVICE_SCORING_MODE と TRANSITION_SENSITIVITY と下のデータの固定の 3 つ・モデルの固定の 4 つだけ (他の鍵はエラーで起動しない)。
#   ADVICE_SCORING_MODE の値は
#   legacy / transition。行を消すかファイルを消すと legacy
# - 起動時の環境変数 ADVICE_SCORING_MODE と値が違うとエラーで起動しない (黙って片方を採用しない)
# - 変えたら再起動 (「更新の反映」か「接続テスト開始」) するまで稼働中のアドバイザーには効かない (操作パネルに食い違いが出る)
ADVICE_SCORING_MODE=legacy
#
# transition の感度 (2026-10-18。楽観側の HP・スカーフ / タスキの仮説での順位。順位には使わない計算):
# - TRANSITION_SENSITIVITY=0 / 1。書かなければ 0 (実機の既定 = 計算しない)。計算させるときだけ 1 にする
# - 規則は ADVICE_SCORING_MODE と同じ (環境変数 TRANSITION_SENSITIVITY と値が違う・0 / 1 以外はエラーで起動しない)
# TRANSITION_SENSITIVITY=1
#
# データの固定 (2026-10-23、正式群の実機。docs/CONNECTION_TEST_CHECKLIST.md §0):
# - 群の開始前に python -m tools.advice_mode --freeze-data を実行し、表示された 3 行をここに書く (方式の切替でも残し、群の後で消す)
# - ADVICE_USAGE_SNAPSHOT = 使用率の snapshot id (DB に無ければ起動しない)、ADVICE_REAL_BANK = 実戦バンクの写しのパス、
#   ADVICE_REAL_BANK_SHA16 = 写しの sha16 (任意。違えば起動しない)。書かなければ従来どおり DB の最新・logs/real_opponents/bank.json
# ADVICE_USAGE_SNAPSHOT=67
# ADVICE_REAL_BANK=/path/to/logs/pinned_data/20261023_180000/bank.json
# ADVICE_REAL_BANK_SHA16=0123456789abcdef
#
# モデルの実体の固定 (2026-10-31、docs/KNOWN_ISSUES.md E-inh-4):
# - 群の開始前に python -m tools.advice_mode --freeze-data --with-models を実行し、表示された 7 行 (データの 3 行 + 下の 4 行) をここに書く
# - ADVICE_RL_POLICY = RL 方策 (.zip) の写しのパス、ADVICE_SELECTION_MODEL = 助言の選出モデル (.pt) の写しのパス、各 _SHA16 = 写しの
#   sha16 (任意。違えば起動しない)。書けば助言はそのファイルだけを読み、無い・違うときは止める (ema → best → 無印、登録チーム向け → 配布版
#   の退避をしない)。書かなければ従来どおり (退避したことは対戦ログの version 行の runtime に残る)
# ADVICE_RL_POLICY=/path/to/logs/pinned_data/20261031_180000/rl_policy.zip
# ADVICE_RL_POLICY_SHA16=0123456789abcdef
# ADVICE_SELECTION_MODEL=/path/to/logs/pinned_data/20261031_180000/selection_model.pt
# ADVICE_SELECTION_MODEL_SHA16=fedcba9876543210
