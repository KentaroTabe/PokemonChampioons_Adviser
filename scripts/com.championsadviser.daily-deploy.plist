<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.championsadviser.daily-deploy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kenta/GitHub/PokemonChampioons_Adviser/scripts/deploy.sh</string>
        <string>--force</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>5</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <!-- deploy.sh が nohup で再起動したアドバイザーを、ジョブ終了時の
         プロセスグループ掃除で巻き添え終了させないために必須 -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/kenta/GitHub/PokemonChampioons_Adviser/logs/daily_deploy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kenta/GitHub/PokemonChampioons_Adviser/logs/daily_deploy.log</string>
</dict>
</plist>
